#if UNITY_EDITOR

using System.IO;
using PandaMix;
using UnityEditor;

public class XlsxExplorer
{
{{~ for xlsx_info in __xlsx_tables ~}}
    [MenuItem("数据档/{{~xlsx_info.item1~}}")]
    public static void Open{{~xlsx_info.item2~}}Xlsx()
    {
        var path = Path.Combine(Directory.GetCurrentDirectory(), "{{~xlsx_info.item4~}}", "{{~xlsx_info.item3~}}");
        FileExplorer.ProcessFileOpen(path);
    }
{{~end~}}

#if EDITOR_DEBUG
{{~ for xlsx_info in __xlsx_tables ~}}
    {{~if xlsx_info.item5 != "" ~}}
    [MenuItem("数据档定义/{{~xlsx_info.item1~}}")]
    public static void Open{{~xlsx_info.item2~}}Def()
    {
        var path = Path.Combine(Directory.GetCurrentDirectory(), "{{~string.slice xlsx_info.item5 3~}}");
        if (!File.Exists(path))
        {
            path = Path.Combine(Directory.GetCurrentDirectory(), "{{~xlsx_info.item5~}}");
        }
        FileExplorer.ProcessFileOpen(path);
    }
    {{~end~}}
{{~end~}}
#endif
}
#endif
