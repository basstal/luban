{{~
    comment = __enum.comment
    items = __enum.items
~}}


{{namespace_with_grace_begin __namespace_with_top_module}} 
{{~if comment != '' ~}}
    /// <summary>
    /// {{escape_comment comment}}
    /// </summary>
{{~end~}}
    {{~if __enum.is_flags~}}
    [System.Flags]
    {{~end~}}
    public enum {{__name}}
    {
        {{~ for item in items ~}}
{{~if item.comment != '' ~}}
        /// <summary>
        /// {{escape_comment item.comment_or_alias}}
        /// </summary>
        [PandaMix.EnumLabel("{{escape_comment item.comment_or_alias}}")]
{{~end~}}
        {{format_enum_item_name __code_style item.name}} = {{item.value}},
        {{~end~}}
        
{{__editable_content.begin}}   
{{__editable_content.content}}
{{__editable_content.end}}
    }
{{if __generate_alias_mapper}}
    public static class {{__name}}Mapper
    {
        public static System.Collections.Generic.Dictionary<string, {{__name}}> Mapper = new System.Collections.Generic.Dictionary<string, {{__name}}>()
        {
        {{~for item in items~}} 
            {"{{item.alias}}", {{__name}}.{{format_enum_item_name __code_style item.name}}},
        {{~end~}}
        };
    }
{{~end~}}
{{namespace_with_grace_end __namespace_with_top_module}} 
