<?xml version="1.0" encoding="utf-8"?>
<!-- 这里的内容与代码强相关，在不知道代码实现的情况下不要随机更改下面的内容 -->
<module name="Myth"                               >
    <bean name="MythMetadata" comment="表达式的元数据">
        <var name="evaluate_type" type="Myth.MythEvaluateType" comment="表达式类型" />
        <!-- 运算符，例如 &&、||、== 等 -->
        <var name="operator_type" type="Myth.MythOperatorType" comment="运算符" />
        <!-- 函数相关 -->
        <var name="function_name" type="string" comment="函数名" />
        <var name="parameters" type="array,string" comment="函数入参" />
        <var name="is_params" type="bool" comment="是否为可变数量参数类型" />
        <var name="parameter_types" type="array,Myth.MythValueType" comment="函数参数类型" />
        <var name="return_type" type="Myth.MythValueType" comment="函数返回值类型" />
        <!-- 字面值相关 -->
        <var name="literal_value" type="string" comment="字面值常量" />
        <var name="literal_context" type="string" comment="字面值的作用位置" />
    </bean>
    <enum name="MythEvaluateType" unique="TRUE">
        <var name="Unknown" value="0" />
        <var name="GetInt" value="1" />
        <var name="GetBool" value="2" />
        <var name="EvalFunction" value="3" />
        <var name="EvalFunctionReturnBool" value="4" />
    </enum>
    <enum name="MythValueType" unique="TRUE">
        <var name="Unknown" value="0"/>
        <var name="Int" value="1"/>
        <var name="IntTenThousandth" value="2"/>
        <var name="Float" value="3"/>
        <var name="Bool" value="4"/>
        <var name="String" value="5"/>
        <var name="Enum" value="6"/>
    </enum>
    <enum name="MythOperatorType" unique="TRUE">
        <var name="Unknown" value="0" />
        <var name="Equal" value="3" />
        <var name="NotEqual" value="4" />
        <var name="Greater" value="5" />
        <var name="GreaterEqual" value="6" />
        <var name="Less" value="7" />
        <var name="LessEqual" value="8" />
    </enum>
    <enum name="MythLogicalType" unique="TRUE">
        <var name="Unknown" value="0" />
        <var name="And" value="1" />
        <var name="Or" value="2" />
    </enum>
</module>