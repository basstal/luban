                return m_methodDict{{ delegateType.value.item1 }}[functionName]({{ for i in (0..(delegateType.value.item2-1)) ~}}args[{{ i }}]{{~ if i < delegateType.value.item2-1 ~}}, {{ end ~}}{{~ end }});
            {{~ end ~}}
        {{~ end ~}}
        default:
            throw new ArgumentException($"No method matching the given number of arguments ({ args.Length }).");
    }
}

public static bool Evaluate(string functionName, List<int> arg)
