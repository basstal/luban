public static int GetConstValue(string key)
{
    if (m_constValues.TryGetValue(key, out var value))
    {
        return value;
    }
    throw new ArgumentException($"Constant with key '{key}' not found.");
}

public static Dictionary<string, Func<List<int>, int>> valueCalls = new Dictionary<string, Func<List<int>, int>>
