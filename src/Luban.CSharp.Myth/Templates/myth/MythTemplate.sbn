public static Dictionary<string, Func<List<int>, int>> valueCalls = new Dictionary<string, Func<List<int>, int>>
{
    {{ __valueCallMappings }}
};

#region LibraryFunctions
public static int Max(List<int> values)
{
    int maxValue = int.MinValue;
    for (int i = 0; i < values.Count; i++)
    {
        if (values[i] > maxValue)
        {
            maxValue = values[i];
        }
    }

    return maxValue;
}

public static int Min(List<int> values)
{
    int minValue = int.MaxValue;
    for (int i = 0; i < values.Count; i++)
    {
        if (values[i] < minValue)
        {
            minValue = values[i];
        }
    }

    return minValue;
}

public static int Average(List<int> values)
{
    if (values.Count == 0)
    {
        return 0;
    }

    int sum = 0;
    for (int i = 0; i < values.Count; i++)
    {
        sum += values[i];
    }

    return sum / values.Count;
}

public static bool Any(List<int> values, int target)
{
    if (values.Count == 0)
    {
        return false;
    }

    for (int i = 0; i < values.Count; i++)
    {
        if (values[i] == target)
        {
            return true;
        }
    }

    return false;
}

public static bool AllGreatEqual(List<int> values, int target)
{
    if (values.Count == 0)
    {
        return true;  // 空列表返回 true，因为没有元素违反条件
    }

    foreach (var value in values)
    {
        if (value < target)
        {
            return false; // 如果有任何一个值小于 target，则返回 false
        }
    }

    return true; // 如果所有值都大于等于 target，则返回 true
}
#endregion

}

